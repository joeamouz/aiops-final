route:
  receiver: "keep"
  group_by: ["alertname"]
  group_wait: 10s
  group_interval: 1m
  repeat_interval: 5m

receivers:
  - name: "keep"
    webhook_configs:
      - url: "http://keep-backend:8080/alerts/event/prometheus"
        send_resolved: true
        http_config:
          basic_auth:
            username: "keep"
            password: "__KEEP_WEBHOOK_API_KEY__"
